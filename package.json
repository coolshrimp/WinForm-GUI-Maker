{
    "name": "formforge",
    "displayName": "UI Maker — .NET UI Designer",
    "description": "Visual drag-and-drop designer, side panel, run/stop & debug toggles, single-exe publishing, and project scaffolding for .NET desktop apps (WPF & WinForms, C# & VB) inside VS Code.",
    "version": "0.5.0",
    "publisher": "formforge",
    "license": "MIT",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "wpf",
        "xaml",
        "winforms",
        "designer",
        "dotnet",
        "form designer",
        "gui builder"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "uimaker",
                    "title": "UI Maker",
                    "icon": "media/sidebar-icon.svg"
                }
            ]
        },
        "views": {
            "uimaker": [
                {
                    "id": "formforge.sidebar",
                    "name": "Designer",
                    "icon": "media/sidebar-icon.svg",
                    "contextualTitle": "UI Maker"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "formforge.designer",
                "displayName": "UI Maker Designer",
                "selector": [
                    {
                        "filenamePattern": "*.xaml"
                    },
                    {
                        "filenamePattern": "*.Designer.cs"
                    }
                ],
                "priority": "option"
            }
        ],
        "commands": [
            {
                "command": "formforge.newProject",
                "title": "New .NET Desktop Project",
                "category": "UI Maker",
                "icon": "$(new-folder)"
            },
            {
                "command": "formforge.openDesigner",
                "title": "Open in Designer",
                "category": "UI Maker",
                "icon": "$(layout)"
            },
            {
                "command": "formforge.openCodeBeside",
                "title": "View XAML Source (Beside)",
                "category": "UI Maker",
                "icon": "$(code)"
            },
            {
                "command": "formforge.build",
                "title": "Build",
                "category": "UI Maker",
                "icon": "$(tools)"
            },
            {
                "command": "formforge.run",
                "title": "Run App",
                "category": "UI Maker",
                "icon": "$(play)"
            },
            {
                "command": "formforge.debug",
                "title": "Debug App",
                "category": "UI Maker",
                "icon": "$(debug-alt)"
            },
            {
                "command": "formforge.release",
                "title": "Build Release (Publish)",
                "category": "UI Maker",
                "icon": "$(package)"
            },
            {
                "command": "formforge.stop",
                "title": "Stop Running App",
                "category": "UI Maker",
                "icon": "$(debug-stop)"
            },
            {
                "command": "formforge.runToggle",
                "title": "Run / Stop App",
                "category": "UI Maker",
                "icon": "$(play)"
            },
            {
                "command": "formforge.debugToggle",
                "title": "Debug / Stop Debugging",
                "category": "UI Maker",
                "icon": "$(debug-alt)"
            },
            {
                "command": "formforge.addWindow",
                "title": "New WPF Window",
                "category": "UI Maker",
                "icon": "$(add)"
            },
            {
                "command": "formforge.addForm",
                "title": "New WinForms Form",
                "category": "UI Maker",
                "icon": "$(add)"
            },
            {
                "command": "formforge.duplicateDesignFile",
                "title": "Duplicate",
                "category": "UI Maker",
                "icon": "$(copy)"
            },
            {
                "command": "formforge.refreshSidebar",
                "title": "Refresh",
                "category": "UI Maker",
                "icon": "$(refresh)"
            },
            {
                "command": "formforge.recentOpen",
                "title": "Open Project",
                "category": "UI Maker"
            },
            {
                "command": "formforge.recentOpenNewWindow",
                "title": "Open in New Window",
                "category": "UI Maker",
                "icon": "$(multiple-windows)"
            },
            {
                "command": "formforge.recentRemove",
                "title": "Remove from Recent Projects",
                "category": "UI Maker",
                "icon": "$(close)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "formforge.newProject",
                    "when": "view == formforge.sidebar",
                    "group": "navigation@1"
                },
                {
                    "command": "formforge.refreshSidebar",
                    "when": "view == formforge.sidebar",
                    "group": "navigation@2"
                }
            ],
            "editor/title": [
                {
                    "command": "formforge.openDesigner",
                    "when": "(resourceExtname == .xaml || resourceFilename =~ /\\.Designer\\.cs$/) && activeCustomEditorId != formforge.designer",
                    "group": "navigation@1"
                },
                {
                    "command": "formforge.openCodeBeside",
                    "when": "activeCustomEditorId == formforge.designer",
                    "group": "navigation@1"
                },
                {
                    "command": "formforge.runToggle",
                    "when": "formforge.hasProject && resourceExtname =~ /\\.(xaml|cs|vb|csproj|vbproj)$/",
                    "group": "navigation@2"
                },
                {
                    "command": "formforge.debugToggle",
                    "when": "formforge.hasProject && resourceExtname =~ /\\.(xaml|cs|vb|csproj|vbproj)$/",
                    "group": "navigation@3"
                }
            ],
            "explorer/context": [
                {
                    "command": "formforge.openDesigner",
                    "when": "resourceExtname == .xaml || resourceFilename =~ /\\.Designer\\.cs$/",
                    "group": "navigation@10"
                }
            ],
            "view/item/context": [
                {
                    "command": "formforge.recentOpenNewWindow",
                    "when": "view == formforge.sidebar && viewItem == uimakerRecent",
                    "group": "inline@1"
                },
                {
                    "command": "formforge.recentRemove",
                    "when": "view == formforge.sidebar && viewItem == uimakerRecent",
                    "group": "inline@2"
                },
                {
                    "command": "formforge.addWindow",
                    "when": "view == formforge.sidebar && viewItem == uimakerXamlGroup",
                    "group": "inline@1"
                },
                {
                    "command": "formforge.addWindow",
                    "when": "view == formforge.sidebar && viewItem == uimakerXamlGroup",
                    "group": "1_create@1"
                },
                {
                    "command": "formforge.addForm",
                    "when": "view == formforge.sidebar && viewItem == uimakerFormGroup",
                    "group": "inline@1"
                },
                {
                    "command": "formforge.addForm",
                    "when": "view == formforge.sidebar && viewItem == uimakerFormGroup",
                    "group": "1_create@1"
                },
                {
                    "command": "formforge.duplicateDesignFile",
                    "when": "view == formforge.sidebar && viewItem =~ /^uimaker(Xaml|Form)$/",
                    "group": "inline@1"
                },
                {
                    "command": "formforge.duplicateDesignFile",
                    "when": "view == formforge.sidebar && viewItem =~ /^uimaker(Xaml|Form)$/",
                    "group": "1_create@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "formforge.openDesigner",
                    "when": "resourceExtname == .xaml || resourceFilename =~ /\\.Designer\\.cs$/"
                },
                {
                    "command": "formforge.openCodeBeside",
                    "when": "activeCustomEditorId == formforge.designer"
                },
                {
                    "command": "formforge.refreshSidebar",
                    "when": "false"
                },
                {
                    "command": "formforge.recentOpen",
                    "when": "false"
                },
                {
                    "command": "formforge.recentOpenNewWindow",
                    "when": "false"
                },
                {
                    "command": "formforge.recentRemove",
                    "when": "false"
                },
                {
                    "command": "formforge.duplicateDesignFile",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "UI Maker",
            "properties": {
                "formforge.gridSize": {
                    "type": "number",
                    "default": 8,
                    "minimum": 1,
                    "maximum": 64,
                    "description": "Snap grid size (pixels) on the design canvas."
                },
                "formforge.snapToGrid": {
                    "type": "boolean",
                    "default": true,
                    "description": "Snap control positions and sizes to the grid."
                },
                "formforge.publish.singleFile": {
                    "type": "boolean",
                    "default": false,
                    "description": "Build Release (Publish) produces a single .exe (PublishSingleFile). Applies to modern .NET projects; .NET Framework projects ignore it."
                },
                "formforge.publish.selfContained": {
                    "type": "boolean",
                    "default": false,
                    "description": "Bundle the .NET runtime into the publish output so the app runs on machines without .NET installed (larger output)."
                },
                "formforge.publish.runtime": {
                    "type": "string",
                    "default": "win-x64",
                    "enum": [
                        "win-x64",
                        "win-x86",
                        "win-arm64"
                    ],
                    "description": "Target runtime used for single-file or self-contained publishing."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.4.0"
    }
}
