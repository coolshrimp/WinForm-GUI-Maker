{
    "name": "uimaker",
    "displayName": "UI Maker — .NET UI Designer",
    "description": "Visual drag-and-drop designer for WPF and WinForms (C# and Visual Basic), side panel, run/stop & debug toggles, single-exe publishing, and project scaffolding for .NET desktop apps inside VS Code.",
    "version": "0.20.1",
    "publisher": "coolshrimp",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/coolshrimp/WinForm-GUI-Maker.git"
    },
    "bugs": {
        "url": "https://github.com/coolshrimp/WinForm-GUI-Maker/issues"
    },
    "homepage": "https://github.com/coolshrimp/WinForm-GUI-Maker#readme",
    "icon": "media/icon.png",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "wpf",
        "xaml",
        "winforms",
        "designer",
        "dotnet",
        "form designer",
        "gui builder",
        "xaml intellisense",
        "xaml snippets"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Visual editing remains available, but UI Maker will not execute .NET, NuGet, MSBuild, or conversion commands until the workspace is trusted."
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "UI Maker requires local project files and the installed .NET toolchain."
        }
    },
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "uimaker",
                    "title": "UI Maker",
                    "icon": "media/sidebar-icon.svg"
                }
            ]
        },
        "views": {
            "uimaker": [
                {
                    "id": "uimaker.sidebar",
                    "name": "Designer",
                    "icon": "media/sidebar-icon.svg",
                    "contextualTitle": "UI Maker"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "uimaker.designer",
                "displayName": "UI Maker Designer",
                "selector": [
                    {
                        "filenamePattern": "*.xaml"
                    },
                    {
                        "filenamePattern": "*.Designer.cs"
                    },
                    {
                        "filenamePattern": "*.Designer.vb"
                    }
                ],
                "priority": "option"
            }
        ],
        "commands": [
            {
                "command": "uimaker.newProject",
                "title": "New .NET Desktop Project",
                "category": "UI Maker",
                "icon": "$(new-folder)"
            },
            {
                "command": "uimaker.openProject",
                "title": "Open Project (Any Folder)…",
                "category": "UI Maker",
                "icon": "$(folder-opened)"
            },
            {
                "command": "uimaker.openDesigner",
                "title": "Open in Designer",
                "category": "UI Maker",
                "icon": "$(layout)"
            },
            {
                "command": "uimaker.openCodeBeside",
                "title": "View XAML Source (Beside)",
                "category": "UI Maker",
                "icon": "$(code)"
            },
            {
                "command": "uimaker.build",
                "title": "Build",
                "category": "UI Maker",
                "icon": "$(tools)"
            },
            {
                "command": "uimaker.run",
                "title": "Run App",
                "category": "UI Maker",
                "icon": "$(play)"
            },
            {
                "command": "uimaker.debug",
                "title": "Debug App",
                "category": "UI Maker",
                "icon": "$(debug-alt)"
            },
            {
                "command": "uimaker.release",
                "title": "Build Release (Publish)",
                "category": "UI Maker",
                "icon": "$(package)"
            },
            {
                "command": "uimaker.createInstaller",
                "title": "Create Installer (Inno Setup)",
                "category": "UI Maker",
                "icon": "$(package)"
            },
            {
                "command": "uimaker.stop",
                "title": "Stop Running App",
                "category": "UI Maker",
                "icon": "$(debug-stop)"
            },
            {
                "command": "uimaker.runToggle",
                "title": "Run / Stop App",
                "category": "UI Maker",
                "icon": "$(play)"
            },
            {
                "command": "uimaker.debugToggle",
                "title": "Debug / Stop Debugging",
                "category": "UI Maker",
                "icon": "$(debug-alt)"
            },
            {
                "command": "uimaker.addWindow",
                "title": "New WPF Window",
                "category": "UI Maker",
                "icon": "$(add)"
            },
            {
                "command": "uimaker.addForm",
                "title": "New WinForms Form",
                "category": "UI Maker",
                "icon": "$(add)"
            },
            {
                "command": "uimaker.duplicateDesignFile",
                "title": "Duplicate",
                "category": "UI Maker",
                "icon": "$(copy)"
            },
            {
                "command": "uimaker.refreshSidebar",
                "title": "Refresh",
                "category": "UI Maker",
                "icon": "$(refresh)"
            },
            {
                "command": "uimaker.recentOpen",
                "title": "Open Project",
                "category": "UI Maker"
            },
            {
                "command": "uimaker.recentOpenNewWindow",
                "title": "Open in New Window",
                "category": "UI Maker",
                "icon": "$(multiple-windows)"
            },
            {
                "command": "uimaker.recentRemove",
                "title": "Remove from Recent Projects",
                "category": "UI Maker",
                "icon": "$(close)"
            },
            {
                "command": "uimaker.recentRevealFolder",
                "title": "Open Folder in File Explorer",
                "category": "UI Maker",
                "icon": "$(folder-opened)"
            },
            {
                "command": "uimaker.openWorkingFolder",
                "title": "Open Working Folder",
                "category": "UI Maker",
                "icon": "$(folder-opened)"
            },
            {
                "command": "uimaker.selectWorkingFolder",
                "title": "Select Working Folder (Project)",
                "category": "UI Maker",
                "icon": "$(root-folder)"
            },
            {
                "command": "uimaker.appSettings",
                "title": "App Settings",
                "category": "UI Maker",
                "icon": "$(settings-gear)"
            },
            {
                "command": "uimaker.projectProperties",
                "title": "Project Properties",
                "category": "UI Maker",
                "icon": "$(gear)"
            },
            {
                "command": "uimaker.nugetPackages",
                "title": "NuGet Packages",
                "category": "UI Maker",
                "icon": "$(archive)"
            },
            {
                "command": "uimaker.convertToSdk",
                "title": "Convert Project to SDK Style (fix 'unsupported format')",
                "category": "UI Maker",
                "icon": "$(arrow-up)"
            },
            {
                "command": "uimaker.openGuide",
                "title": "Guide: How to Build an App",
                "category": "UI Maker",
                "icon": "$(book)"
            },
            {
                "command": "uimaker.addCsFile",
                "title": "New C# Class File",
                "category": "UI Maker",
                "icon": "$(add)"
            },
            {
                "command": "uimaker.addImage",
                "title": "Add Image to Resources",
                "category": "UI Maker",
                "icon": "$(add)"
            },
            {
                "command": "uimaker.addResource",
                "title": "Add Resource File",
                "category": "UI Maker",
                "icon": "$(add)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "uimaker.newProject",
                    "when": "view == uimaker.sidebar",
                    "group": "navigation@1"
                },
                {
                    "command": "uimaker.refreshSidebar",
                    "when": "view == uimaker.sidebar",
                    "group": "navigation@2"
                },
                {
                    "command": "uimaker.openGuide",
                    "when": "view == uimaker.sidebar",
                    "group": "navigation@3"
                }
            ],
            "editor/title": [
                {
                    "command": "uimaker.openDesigner",
                    "when": "(resourceExtname == .xaml || resourceFilename =~ /\\.Designer\\.(cs|vb)$/) && activeCustomEditorId != uimaker.designer",
                    "group": "navigation@1"
                },
                {
                    "command": "uimaker.openCodeBeside",
                    "when": "activeCustomEditorId == uimaker.designer",
                    "group": "navigation@1"
                },
                {
                    "command": "uimaker.runToggle",
                    "when": "uimaker.hasProject && resourceExtname =~ /\\.(xaml|cs|vb|csproj|vbproj)$/",
                    "group": "navigation@2"
                },
                {
                    "command": "uimaker.debugToggle",
                    "when": "uimaker.hasProject && resourceExtname =~ /\\.(xaml|cs|vb|csproj|vbproj)$/",
                    "group": "navigation@3"
                }
            ],
            "explorer/context": [
                {
                    "command": "uimaker.openDesigner",
                    "when": "resourceExtname == .xaml || resourceFilename =~ /\\.Designer\\.(cs|vb)$/",
                    "group": "navigation@10"
                }
            ],
            "view/item/context": [
                {
                    "command": "uimaker.recentOpenNewWindow",
                    "when": "view == uimaker.sidebar && viewItem == uimakerRecent",
                    "group": "inline@1"
                },
                {
                    "command": "uimaker.recentRevealFolder",
                    "when": "view == uimaker.sidebar && viewItem == uimakerRecent",
                    "group": "inline@2"
                },
                {
                    "command": "uimaker.recentRemove",
                    "when": "view == uimaker.sidebar && viewItem == uimakerRecent",
                    "group": "inline@3"
                },
                {
                    "command": "uimaker.addWindow",
                    "when": "view == uimaker.sidebar && viewItem == uimakerXamlGroup",
                    "group": "inline@1"
                },
                {
                    "command": "uimaker.addWindow",
                    "when": "view == uimaker.sidebar && viewItem == uimakerXamlGroup",
                    "group": "1_create@1"
                },
                {
                    "command": "uimaker.addForm",
                    "when": "view == uimaker.sidebar && viewItem == uimakerFormGroup",
                    "group": "inline@1"
                },
                {
                    "command": "uimaker.addForm",
                    "when": "view == uimaker.sidebar && viewItem == uimakerFormGroup",
                    "group": "1_create@1"
                },
                {
                    "command": "uimaker.addCsFile",
                    "when": "view == uimaker.sidebar && viewItem == uimakerCatCode",
                    "group": "inline@1"
                },
                {
                    "command": "uimaker.addImage",
                    "when": "view == uimaker.sidebar && viewItem == uimakerCatImages",
                    "group": "inline@1"
                },
                {
                    "command": "uimaker.addResource",
                    "when": "view == uimaker.sidebar && viewItem == uimakerCatResources",
                    "group": "inline@1"
                },
                {
                    "command": "uimaker.duplicateDesignFile",
                    "when": "view == uimaker.sidebar && viewItem =~ /^uimaker(Xaml|Form)$/",
                    "group": "inline@1"
                },
                {
                    "command": "uimaker.duplicateDesignFile",
                    "when": "view == uimaker.sidebar && viewItem =~ /^uimaker(Xaml|Form)$/",
                    "group": "1_create@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "uimaker.openDesigner",
                    "when": "resourceExtname == .xaml || resourceFilename =~ /\\.Designer\\.(cs|vb)$/"
                },
                {
                    "command": "uimaker.openCodeBeside",
                    "when": "activeCustomEditorId == uimaker.designer"
                },
                {
                    "command": "uimaker.refreshSidebar",
                    "when": "false"
                },
                {
                    "command": "uimaker.recentOpen",
                    "when": "false"
                },
                {
                    "command": "uimaker.recentOpenNewWindow",
                    "when": "false"
                },
                {
                    "command": "uimaker.recentRemove",
                    "when": "false"
                },
                {
                    "command": "uimaker.recentRevealFolder",
                    "when": "false"
                },
                {
                    "command": "uimaker.duplicateDesignFile",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "UI Maker",
            "properties": {
                "uimaker.gridSize": {
                    "type": "number",
                    "default": 8,
                    "minimum": 1,
                    "maximum": 64,
                    "description": "Snap grid size (pixels) on the design canvas."
                },
                "uimaker.snapToGrid": {
                    "type": "boolean",
                    "default": true,
                    "description": "Snap control positions and sizes to the grid."
                },
                "uimaker.xamlIntelliSense": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable UI Maker XAML IntelliSense in the text editor: element/attribute/value completions, code snippets, hover documentation, and inline color swatches with a picker."
                },
                "uimaker.publish.askMode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ask how to publish on every Build Release (folder / single EXE / single EXE with bundled runtime). Turn off to silently use the settings below."
                },
                "uimaker.publish.singleFile": {
                    "type": "boolean",
                    "default": false,
                    "description": "Build Release (Publish) produces a single .exe (PublishSingleFile). Applies to modern .NET projects; .NET Framework projects ignore it."
                },
                "uimaker.publish.selfContained": {
                    "type": "boolean",
                    "default": false,
                    "description": "Bundle the .NET runtime into the publish output so the app runs on machines without .NET installed (larger output)."
                },
                "uimaker.publish.runtime": {
                    "type": "string",
                    "default": "win-x64",
                    "enum": [
                        "win-x64",
                        "win-x86",
                        "win-arm64"
                    ],
                    "description": "Target runtime used for single-file or self-contained publishing."
                },
                "uimaker.installer.settingsScope": {
                    "type": "string",
                    "default": "uniform",
                    "enum": [
                        "uniform",
                        "perProject"
                    ],
                    "enumDescriptions": [
                        "One shared installer template for all projects (same branding everywhere; app name/version/output file still follow each project).",
                        "Each project remembers its own installer settings (multi-brand work)."
                    ],
                    "description": "How Create Installer remembers its settings."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "test": "npm run compile && node --test \"tests/*.test.js\"",
        "check": "npm run compile && node --check media/designer.js && node --test \"tests/*.test.js\"",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "1.85.0",
        "typescript": "^5.4.0"
    }
}
